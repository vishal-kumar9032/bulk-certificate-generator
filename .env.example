# Database connection URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./certificates.db

# Storage directory for generated certificates and archives
STORAGE_DIR=./storage

# Number of background worker threads in the pool
WORKER_THREADS=4

# Maximum recipients permitted per single bulk request
MAX_RECIPIENTS_PER_JOB=1000

# When true, processes generation synchronously within request (useful for testing)
SYNC_MODE=false
